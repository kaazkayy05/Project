config_version=5

[application]
config/name="Graveyard Shift"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1152
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.025, 0.035, 0.055, 1)

[input]
move_forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
move_back={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
move_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
move_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
equip_flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
equip_shovel={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
toggle_flashlight={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":70)]
}
release_mouse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
